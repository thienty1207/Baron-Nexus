{
  "schema_version": 1,
  "tested_on": "2026-08-27",
  "dsh": {
    "release_policy": "latest-at-run",
    "adapter_api": "lifecycle-events-v1"
  },
  "codex": {
    "release_policy": "latest-at-run",
    "hook_api": "SessionStart,UserPromptSubmit,PreToolUse,PostToolUse,PreCompact,PostCompact,Stop,SessionEnd"
  },
  "tencent_memory": {
    "api": "v3",
    "repository": "https://github.com/TencentCloud/TencentDB-Agent-Memory.git",
    "ref_policy": "latest-default-head-resolved-to-immutable-commit",
    "data_plane": "conversation,atomic,scenario,core",
    "required_isolation": "team_id,agent_id,user_id"
  },
  "duckduckgo_mcp": {
    "server": "nickclyde/duckduckgo-mcp-server",
    "registration": "ddg-search"
  },
  "dsh_plugins": {
    "superpowers-dsh": "latest",
    "@deepseek-ai/dsh-mcp-client": "latest",
    "dsh-reverse-skill": "latest-default-head",
    "baron-dsh-adapter": "0.1.0"
  }
}
