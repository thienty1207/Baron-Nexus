{
  "schema_version": 1,
  "tested_on": "2026-08-27",
  "dsh": {
    "release_policy": "latest-at-run",
    "adapter_api": "lifecycle-events-v1"
  },
  "codex": {
    "release_policy": "latest-at-run",
    "hook_api": "SessionStart,UserPromptSubmit,PreToolUse,PostToolUse,PreCompact,PostCompact,Stop,SessionEnd"
  },
  "tencent_memory": {
    "api": "v3",
    "repository": "https://github.com/TencentCloud/TencentDB-Agent-Memory.git",
    "ref_policy": "latest-default-head-resolved-to-immutable-commit",
    "data_plane": "conversation,atomic,scenario,core",
    "required_isolation": "team_id,agent_id,user_id"
  },
  "duckduckgo_mcp": {
    "server": "nickclyde/duckduckgo-mcp-server",
    "registration": "ddg-search"
  },
  "dsh_plugins": {
    "superpowers-dsh": "latest",
    "@deepseek-ai/dsh-mcp-client": "latest",
    "dsh-reverse-skill": "latest-default-head",
    "baron-dsh-adapter": "0.1.0"
  },
  "managed_runtime": {
    "release": "0.1.22",
    "catalog": "configs/managed-runtime-catalog.json",
    "resolution": "one immutable plan per install/update with stable exact platform and architecture",
    "required_components": ["uv", "python", "strix", "bun", "go", "node", "npm", "pnpm", "dsh", "codex"],
    "install_methods": {
      "archive": "verified archive extraction",
      "npm": "verified package artifact installed into a Baron generation with scripts disabled",
      "uv-tool": "verified package artifact installed by managed uv into a Baron generation"
    },
    "python": {
      "policy": "newest stable CPython compatible with the resolved Strix release",
      "tested_min": "3.12",
      "tested_max": "3.14"
    },
    "packages": {
      "strix": "strix-agent",
      "dsh": "@deepseek-ai/dsh",
      "codex": "@openai/codex",
      "pnpm": "pnpm"
    }
  }
}
